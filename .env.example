# ==============================================================================
# DC PORTAL TEMPLATE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file to Git!

# ------------------------------------------------------------------------------
# 1. CORE SERVER & BRANDING SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
PORTAL_BASE_URL=https://your-portal-domain.run.app
COMPANY_NAME=My Company
DEFAULT_BANK_ACCOUNT=MAIN-ACCOUNT

# Super Admin emails (comma-separated). Users with these emails have unconditional root access.
SUPERADMIN_EMAILS=admin@example.com,developer@example.com

# Allowed email domains for single-use OTP email login (comma-separated).
# If left blank, any valid email can request an OTP.
ALLOWED_EMAIL_DOMAINS=example.com,mycompany.vn

# Encryption key for integration secret storage (defaults to LARK_APP_SECRET if not specified)
INTEGRATION_CONFIG_KEY=your-secure-random-encryption-key-32-chars

# ------------------------------------------------------------------------------
# 2. LARK SUITE / FEISHU AUTHENTICATION & BOT INTEGRATION
# ------------------------------------------------------------------------------
# Obtain from Lark Developer Console (https://open.larksuite.com)
LARK_APP_ID=cli_xxxxxxxxxxxxxx
LARK_APP_SECRET=your_lark_app_secret
LARK_REDIRECT_URI=https://your-portal-domain.run.app/auth/lark/callback

# Allowed Lark user emails for login (comma-separated, empty = allow all company members)
LARK_LOGIN_ALLOWLIST=

# Default notification chat / group open_id (e.g. oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
LARK_NOTIFICATION_CHAT_ID=
LARK_ORDER_NOTIFICATION_CHAT_ID=
LARK_ORDER_NOTIFICATION_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD PLATFORM (GCP) & STORAGE
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
UPLOAD_BUCKET=your-gcs-bucket-name

# BigQuery Data Warehouse
DATA_WAREHOUSE_PROJECT=your-gcp-project-id
DATA_WAREHOUSE_DATASET=portal_warehouse

# Optional secondary warehouse (e.g., Bluecore ingestion)
BLUECORE_BIGQUERY_PROJECT=
BLUECORE_BIGQUERY_DATASET=

# ------------------------------------------------------------------------------
# 4. E-COMMERCE & ORDER CHANNELS
# ------------------------------------------------------------------------------
# Shopify Store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Order Ingest Webhook Secret (Shared header key: x-dc-order-secret)
ORDER_INGEST_SECRET=your_order_ingest_secret_key

# Pancake POS / Webhook Integration
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=
PANCAKE_AUTO_PUSH=true

# 17Track Tracking API
SEVENTEENTRACK_API_KEY=

# ------------------------------------------------------------------------------
# 5. DIGITAL MARKETING & ADS INTEGRATIONS
# ------------------------------------------------------------------------------
# Meta Marketing API & CRM Conversions API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-portal-domain.run.app/auth/meta/callback
META_ADS_ACCOUNT_ID=act_xxxxxxxxxxxxxxx
META_ADS_ACCESS_TOKEN=EAA...
META_SYSTEM_USER_ACCESS_TOKEN=EAA...
META_GRAPH_VERSION=v23.0
META_CRM_GRAPH_VERSION=v26.0
META_SYNC_CRON_SECRET=your_cron_secret_key

# Google Ads & TikTok Ads
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_ADVERTISER_ID=

# ------------------------------------------------------------------------------
# 6. BANKING & SEPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your API key from https://my.sepay.vn
SEPAY_API_KEY=

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL SERVICE (FOR OTP & NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Defaults to Lark SMTP (smtp.larksuite.com:465) or use Gmail/SendGrid/SES
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Organization Portal" <no-reply@example.com>
